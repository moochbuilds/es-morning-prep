# ---------------------------------------------------------------------------
# ES Morning Prep — environment variables
#
# Local: copy to .env.local (gitignored). Deployed: set the same names as
# GitHub Actions secrets (Settings → Secrets and variables → Actions).
# Everything here is read by scripts/build-data.ts, never by the browser.
# ---------------------------------------------------------------------------

# Data layer.
#   live  -> real providers (default)
#   mock  -> deterministic simulated data, for offline UI work
DATA_MODE=live

# Mock story when DATA_MODE=mock:
#   reference | stress | credit-divergence | vol-shock
MOCK_SCENARIO=reference

# ---------------------------------------------------------------------------
# Sources in use. Only FRED needs a key:
#
#   Futures / VIX family / sectors / HYG, LQD / breadth   Yahoo (unofficial, delayed)
#   Treasury curve, nominal + real                        home.treasury.gov
#   HY + IG credit spreads                                FRED API
#   VX futures                                            cboe.com (delayed)
#   Economic calendar                                     tradingeconomics.com (US, 2-star+)
#   Earnings calendar + EPS surprise                      api.nasdaq.com
#   S&P 500 membership                                    datahub constituents dataset
# ---------------------------------------------------------------------------

# Credit spreads (HY + IG OAS). Free key: https://fredaccount.stlouisfed.org/apikey
# Without it the credit row falls back to FRED's CSV export, which FRED
# rate-limits aggressively — expect UNAVAILABLE some of the time.
FRED_API_KEY=

# AI explanation of Today's Read. Optional. The model only explains the
# engine's classifications; if unset, the deterministic writer is used and no
# AI request is ever made. The dashboard is fully functional either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
