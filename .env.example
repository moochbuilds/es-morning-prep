# ---------------------------------------------------------------------------
# ES Morning Prep — environment variables
#
# Local: copy to .env.local (gitignored). Deployed: set the same names as
# GitHub Actions secrets (Settings → Secrets and variables → Actions).
# Everything here is read by scripts/build-data.ts, never by the browser.
# ---------------------------------------------------------------------------

# Data layer.
#   live  -> real providers (default)
#   mock  -> deterministic simulated data, for offline UI work
DATA_MODE=live

# ---------------------------------------------------------------------------
# Sources in use. Only FRED needs a key:
#
#   Futures / VIX / sectors / breadth   Yahoo Finance (unofficial, delayed)
#   10Y yield                           Cboe ^TNX via Yahoo
#   2Y yield + curve                    home.treasury.gov par yield curve
#   HY credit spread                    FRED API (BAMLH0A0HYM2)
#   Economic calendar                   tradingeconomics.com (US, 2-star+)
#   Earnings calendar + EPS surprise    api.nasdaq.com
#   S&P 500 membership                  datahub constituents dataset
# ---------------------------------------------------------------------------

# Credit spreads (HY OAS). Free key: https://fredaccount.stlouisfed.org/apikey
# Without it the credit row falls back to FRED's CSV export, which FRED
# rate-limits aggressively — expect UNAVAILABLE some of the time.
FRED_API_KEY=

# AI interpretation (Today's Read, earnings takeaways). Optional.
# If unset, the deterministic rule-based writer is used and no AI request is
# ever made. The dashboard is fully functional either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
